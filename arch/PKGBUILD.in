# SPDX-License-Identifier: GPL-3.0-or-later
# Generated by ./build-arch from a local source snapshot.
pkgname=gxde-terminal
pkgver=@VERSION@
pkgrel=1
pkgdesc='GXDE terminal emulator with tabs, split panes and Kitty graphics'
arch=('x86_64')
url='https://github.com/GXDE-OS/gxde-terminal'
license=('GPL-3.0-or-later' 'GPL-2.0-or-later' 'LGPL-3.0-or-later' 'BSD-3-Clause' 'CC-BY-4.0' 'CC0-1.0')
depends=(
  'dtk6core' 'dtk6gui' 'dtk6widget' 'qt6-base' 'qt6-5compat'
  'glib2' 'glibc' 'gcc-libs' 'libsecret' 'libx11' 'libxcb' 'xcb-util-wm'
  'libchardet' 'uchardet' 'icu' 'zlib' 'kwindowsystem' 'hicolor-icon-theme'
  'expect' 'zssh' 'openssh'
)
makedepends=('cmake' 'ninja' 'pkgconf' 'qt6-tools' 'lxqt-build-tools')
optdepends=('qt6-wayland: native Wayland display support')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('@SHA256@')

build() {
  cmake -S "$srcdir/$pkgname-$pkgver" -B "$srcdir/build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DVERSION="$pkgver" \
    -DAPP_VERSION="$pkgver" \
    -DTERM_RPATH=OFF \
    -DINSTALL_USER_MANUAL=OFF \
    -DRUNDIR_KEYBOARD_LAYOUT_FIRST=OFF
  cmake --build "$srcdir/build"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"
  install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/$pkgname-$pkgver/THIRD_PARTY_NOTICES.md" \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
}
