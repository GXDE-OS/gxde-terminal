[Desktop Entry]
Categories=DDE;Utility;System;TerminalEmulator;
Comment=Use the command line
Exec=gxde-terminal %u
GenericName=Terminal
Icon=gxde-terminal
Keywords=shell;prompt;command;commandline;
Name=GXDE Terminal
StartupNotify=false
TryExec=gxde-terminal
Type=Application
X-Deepin-Vendor=gxde
X-Deepin-Singleton=true
Actions=new-window;quake-mode;
MimeType=x-scheme-handler/dsg-terminal-exec
X-TerminalArgExec=-e
X-TerminalArgDir=-w

